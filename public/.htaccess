<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    # Keep real files/directories untouched and let React Router handle routes.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>
