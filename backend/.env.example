APP_NAME="ROUH ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
# Production DB: MariaDB 10.6+ LTS is recommended. If an existing verified MySQL 8 production DB is in use, keep it; do not switch engines during go-live.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rouh_erp_production
DB_USERNAME=rouh_app
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rouh_erp
# DB_USERNAME=rouh_app
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Production/owner bootstrap (never commit real credentials)
ROUH_OWNER_EMAIL=
ROUH_OWNER_NAME="ROUH Owner"
ROUH_OWNER_PHONE=
ROUH_OWNER_PASSWORD=
SEED_DEMO_USERS=false

# Browser/API session security
ROUH_FRONTEND_URL=https://your-frontend-domain.example
ROUH_AUTH_COOKIE=rouh_auth
ROUH_AUTH_COOKIE_MINUTES=43200
ROUH_AUTH_COOKIE_DOMAIN=
ROUH_AUTH_COOKIE_SAME_SITE=none
ROUH_LEGACY_BEARER_RESPONSE=false
ROUH_ALLOW_OPENING_IMPORT=true
ROUH_ALLOW_LEDGER_REBUILD=false
ROUH_MAX_ORDER_LINE_QTY=100
ROUH_MAX_CONSUMPTION_VARIANCE_PERCENT=10

# First accounting/opening-balance date. No opening balance is created automatically.
# First accounting day for this installation (required before accounting is used).

# Optional customer-service WhatsApp number in international format, digits only.

